    "def barchart(df, width=0.75):\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(16, 6), sharey=False, dpi=120)\n",
    "\n",
    "    # PSNR comparison\n",
    "    axes[0].bar(df.index, df[\"PSNR\"], label=\"DeepCAD\", color=\"tab:blue\", width=width)\n",
    "    axes[0].set_ylim((30,36))\n",
    "    axes[0].set_title(\"PSNR Comparison\")\n",
    "    axes[0].set_xlabel(\"Method\")\n",
    "    axes[0].set_ylabel(\"PSNR\")\n",
    "\n",
    "    # SSIM3D comparison\n",
    "    axes[1].bar(df.index, df[\"SSIM3D\"], label=\"DeepCAD\", color=\"tab:orange\", width=width)\n",
    "    axes[1].set_ylim((0.7,1))\n",
    "    axes[1].set_title(\"SSIM3D Comparison\")\n",
    "    axes[1].set_xlabel(\"Method\")\n",
    "    axes[1].set_ylabel(\"SSIM3D\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
